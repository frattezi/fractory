{
  "name": "fractory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal software factory: rules, skills and deterministic flows on top of Sandcastle and Agent Manager.",
  "bin": { "fractory": "./src/cli.ts" },
  "engines": { "node": ">=22" },
  "scripts": {
    "fractory": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
